    {
      "parameters": {
        "jsCode": "// One audit row per incident: error, RCA, resolution, duration\nconst wr = $('Webhook').first().json.body.workflow_run;\nconst fix = $('Prepare fix').first().json;\nconst dx = $('Parse diagnosis').first().json.diagnosis || {};\nconst trim = $('Trim log').first().json;\nconst pr = $('Open PR').first().json;\nconst approved = $('Slack approval').first().json.data?.approved === true;\n\nlet resolution = 'rejected_closed';\nif (approved) {\n  const m = $('Merge PR').first().json;\n  resolution = m.merged === true ? 'approved_merged' : 'approved_merge_failed';\n}\n\nconst failedAt = new Date(wr.updated_at);\nconst resolvedAt = new Date();\n\nreturn [{ json: {\n  repo: fix.repo,\n  run_id: wr.id,\n  run_url: wr.html_url,\n  head_sha: wr.head_sha,\n  failed_step: trim.failed_step,\n  error_excerpt: String(trim.failing_log || '').slice(0, 2000),\n  root_cause: dx.root_cause || null,\n  bug_location: dx.bug_location || null,\n  confidence: dx.confidence || null,\n  patch_file: fix.patch.file,\n  branch: fix.branch,\n  pr_number: pr.number,\n  pr_url: pr.html_url,\n  resolution,\n  failed_at: failedAt.toISOString(),\n  resolved_at: resolvedAt.toISOString(),\n  duration_seconds: Math.round((resolvedAt - failedAt) / 1000),\n}}];"
      },
