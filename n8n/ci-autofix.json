    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.output || '';\nconst cleaned = raw.replace(/^`{3}(?:json)?\\s*|\\s*`{3}$/g, '').trim();\nlet diagnosis;\ntry { diagnosis = JSON.parse(cleaned); }\ncatch (e) { diagnosis = { parse_error: e.message, raw }; }\n\nreturn [{ json: { ...$('Trim log').first().json, diagnosis } }];"
      },
      "id": "207457f9-29b8-4127-a546-47ac79f00bc4",
      "name": "Parse diagnosis",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1376,
        -16
      ]
    },
    {
      "parameters": {
        "jsCode": "// Validate the agent's patch and prepare branch / PR metadata\nconst d = $input.first().json;\nconst dx = d.diagnosis || {};\nconst p = dx.patch;\n\nif (dx.parse_error) throw new Error('Agent output was not valid JSON: ' + String(dx.raw).slice(0, 300));\nif (!p || !p.file || !Array.isArray(p.edits) || p.edits.length === 0) {\n  throw new Error('Agent returned no usable patch. Confidence: ' + dx.confidence);\n}\nif (dx.confidence === 'low') throw new Error('Agent confidence is low - not opening a PR.');\nif (p.edits.length > 5) throw new Error('Patch has ' + p.edits.length + ' edits - too large for an auto-fix.');\n\nconst file = String(p.file).replace(/^\\/+/, '');\nconst stamp = new Date().toISOString().replace(/[-:T]/g, '').slice(0, 14);\nconst branch = `autofix/run-${d.run_id}-${stamp}`;\n\nconst firstSentence = String(dx.root_cause || 'CI failure').split(/(?<=\\.)\\s/)[0];\nconst shortCause = firstSentence.length > 70 ? firstSentence.slice(0, 67) + '...' : firstSentence;\n\nconst pr_body = [\n  '## 🤖 Automated CI fix',\n  '',\n  `**Failed run:** [#${d.run_id}](${d.run_url}) - job \\`${d.job_name}\\`, step \\`${d.failed_step}\\``,\n  `**Failing commit:** \\`${String(d.head_sha).slice(0, 7)}\\` - ${String(d.commit_message || '').split('\\n')[0]}`,\n  '',\n  '### Root cause',\n  dx.root_cause || '-',\n  '',\n  '### Evidence',\n  dx.evidence || '-',\n  '',\n  '### Fix',\n  `${dx.proposed_fix || '-'}`,\n  '',\n  `**Changed file:** \\`${file}\\` (${p.edits.length} edit${p.edits.length > 1 ? 's' : ''}) | **Bug location:** ${dx.bug_location} | **Confidence:** ${dx.confidence}`,\n  '',\n  '<details><summary>Failing log</summary>',\n  '',\n  '```',\n  d.failing_log || '',\n  '```',\n  '</details>',\n  '',\n  '> Generated by the CI Autofix agent. Review before merging.',\n].join('\\n');\n\nreturn [{ json: {\n  repo: d.repo,\n  base_branch: d.head_branch,\n  run_id: d.run_id,\n  branch,\n  patch: { file, edits: p.edits },\n  commit_message: `fix(ci): ${shortCause}\\n\\nAuto-fix for failed run ${d.run_id}.`,\n  pr_title: `🤖 Autofix: ${shortCause}`,\n  pr_body,\n}}];"
      },
