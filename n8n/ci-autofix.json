    {
      "parameters": {
        "jsCode": "// Apply find/replace edits to the FRESH file content and re-encode it\nconst fix = $('Prepare fix').first().json;\nconst file = $input.first().json;\n\nlet text = Buffer.from(file.content, 'base64').toString('utf8');\nconst original = text;\n\nfix.patch.edits.forEach((e, i) => {\n  if (typeof e.find !== 'string' || e.find.length === 0) throw new Error(`Edit ${i}: empty \"find\"`);\n  const count = text.split(e.find).length - 1;\n  if (count !== 1) {\n    throw new Error(`Edit ${i}: \"find\" matched ${count} times in ${fix.patch.file} (must be exactly 1). find=${JSON.stringify(e.find)}`);\n  }\n  text = text.replace(e.find, () => (e.replace ?? ''));\n});\n\nif (text === original) throw new Error('Patch made no changes to the file');\n\nreturn [{ json: {\n  path: fix.patch.file,\n  sha: file.sha,               // sha fetched seconds ago from the fix branch\n  content_b64: Buffer.from(text, 'utf8').toString('base64'),\n  message: fix.commit_message,\n  new_content: text,\n}}];"
      },
