      "parameters": {
        "jsCode": "const body = $('Webhook').first().json.body;\nconst run = body.workflow_run;\nconst jobs = $input.first().json.jobs || [];\nconst job = jobs.find(j => j.conclusion === 'failure');\nif (!job) return [];\nconst step = (job.steps || []).find(s => s.conclusion === 'failure');\n\nreturn [{ json: {\n  repo: body.repository.full_name,\n  run_id: run.id,\n  run_url: run.html_url,\n  head_sha: run.head_sha,\n  head_branch: run.head_branch,\n  commit_message: run.head_commit?.message,\n  job_id: job.id,\n  job_name: job.name,\n  failed_step: step?.name ?? 'unknown',\n}}];"
      },
      "id": "6ff3b91e-0f2e-4e23-9778-34de08eb6d62",
      "name": "Find failed job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        128,
        -16
      ]
    },
    {
      "parameters": {
        "jsCode": "// Trim the job log to the failing section and scrub secrets before anything reaches the LLM\nconst meta = { ...$('Find failed job').first().json };\nconst raw = $input.first().json.log || '';\n\n// 1) Strip the timestamp prefix from every line\nconst lines = raw.split('\\n').map(l => l.replace(/^\\d{4}-\\d{2}-\\d{2}T[\\d:.]+Z\\s?/, ''));\n\n// 2) Isolate the step that errored: from its \"##[group]Run\" header to the first ##[error]\nconst errIdx = lines.findIndex(l => l.startsWith('##[error]'));\nconst end = errIdx === -1 ? lines.length : errIdx + 1;\nlet start = 0;\nfor (let i = end - 1; i >= 0; i--) {\n  if (lines[i].startsWith('##[group]Run ')) { start = i; break; }\n}\nlet section = lines.slice(start, end);\n\n// 3) If pytest ran, keep just the FAILURES / ERRORS block through the final summary line\nconst f = section.findIndex(l => /^=+ (FAILURES|ERRORS) =+$/.test(l));\nif (f !== -1) {\n  const e = section.findIndex((l, i) => i > f && /^=+ .* in [\\d.]+s/.test(l));\n  section = section.slice(f, e === -1 ? section.length : e + 1);\n}\n\n// 4) Scrub anything that looks like a secret (done BEFORE truncation)\nconst SECRET_PATTERNS = [\n  [/-----BEGIN [A-Z ]*PRIVATE KEY-----[\\s\\S]*?-----END [A-Z ]*PRIVATE KEY-----/g, '[REDACTED_PRIVATE_KEY]'],\n  [/\\b(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{20,}/g, '[REDACTED_GITHUB_TOKEN]'],\n  [/\\bgithub_pat_[A-Za-z0-9_]{20,}/g, '[REDACTED_GITHUB_TOKEN]'],\n  [/\\bxox[abprs]-[A-Za-z0-9-]{10,}/g, '[REDACTED_SLACK_TOKEN]'],\n  [/\\bAIza[0-9A-Za-z_-]{35}/g, '[REDACTED_GOOGLE_KEY]'],\n  [/\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b/g, '[REDACTED_AWS_KEY]'],\n  [/\\bsk-[A-Za-z0-9_-]{20,}/g, '[REDACTED_API_KEY]'],\n  [/\\beyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}/g, '[REDACTED_JWT]'],\n  [/(Bearer\\s+)[A-Za-z0-9._~+\\/-]{16,}=*/gi, '$1[REDACTED]'],\n  [/((?:api[_-]?key|secret|token|password|passwd|pwd|access[_-]?key)[\"']?\\s*[:=]\\s*[\"']?)(?!\\[REDACTED)[^\\s\"',;]{6,}/gi, '$1[REDACTED]'],\n  [/(:\\/\\/[^:\\s\\/@]+:)[^@\\s]+@/g, '$1[REDACTED]@'],\n];\nlet redactions = 0;\nconst scrub = (text) => {\n  let out = String(text ?? '');\n  for (const [re, rep] of SECRET_PATTERNS) {\n    out = out.replace(re, (...m) => {\n      redactions++;\n      return rep.includes('$1') ? rep.replace('$1', typeof m[1] === 'string' ? m[1] : '') : rep;\n    });\n  }\n  return out;\n};\n\nlet failing_log = scrub(section.join('\\n'));\nmeta.commit_message = scrub(meta.commit_message);\n\n// 5) Hard cap so a runaway log can't flood the LLM\nconst MAX = 8000;\nif (failing_log.length > MAX) failing_log = '...[truncated]\\n' + failing_log.slice(-MAX);\n\nreturn [{ json: { ...meta, failing_log, raw_log_lines: lines.length, redactions } }];"
      },
